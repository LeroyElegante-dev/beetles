<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:minHeight="72dp"
    android:orientation="vertical"
    android:padding="8dp">

    <TextView
        android:id="@+id/tvSkinName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textAppearance="?attr/textAppearanceTitleMedium"
        tools:text="Классический" />

    <com.example.beetles.game.BeetleSetPreviewView
        android:id="@+id/previewSet"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_marginTop="4dp"
        android:background="@color/game_field" />

    <TextView
        android:id="@+id/tvSkinMeta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="2dp"
        android:textAppearance="?attr/textAppearanceBodySmall"
        tools:text="Жук · Гонщик · Сердечко · Скарабей" />
</LinearLayout>
